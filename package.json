{
  "name": "wildgent",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@wildgent/game",
    "typecheck": "turbo run typecheck",
    "check": "biome check . && turbo run typecheck test",
    "format": "biome format --write .",
    "test": "turbo run test",
    "deploy": "npm run deploy --workspace=@wildgent/game"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
